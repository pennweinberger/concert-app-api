generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ModerationStatus {
  PENDING
  ALLOWED
  WARNED
  BLOCKED
}

model User {
  id              String   @id @default(cuid())
  handle          String   @unique
  email           String?  @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?
  anonymizedAt    DateTime?

  reviews            Review[]
  reviewLikes        ReviewLike[]
  reviewComments     ReviewComment[]
  attendances        Attendance[]
  verificationTokens VerificationToken[]

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsActed    Notification[] @relation("NotificationsActed")
}

model VerificationToken {
  id          String    @id @default(cuid())
  userId      String
  type        String                       // "email_verify" | "password_reset"
  token       String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Artist {
  id                   String   @id @default(cuid())
  name                 String   @unique
  ticketmasterId       String?  @unique
  diceId               String?  @unique
  mbid                 String?
  mbidConfidence       Float?
  lastMbidLookupAt     DateTime?
  lastSetlistfmFetchAt DateTime?

  shows                Show[]
  providerMatchReviews ProviderMatchReview[]
}

model Venue {
  id               String   @id @default(cuid())
  name             String
  city             String
  country          String?
  timezone         String?
  createdAt        DateTime @default(now())
  lastDiceFetchAt  DateTime?

  shows                Show[]
  externalRefs         VenueExternalRef[]
  providerMatchReviews ProviderMatchReview[]

  @@unique([name, city])
}

model VenueExternalRef {
  id              String @id @default(cuid())
  venueId         String
  provider        String
  providerVenueId String
  rawPayload      Json?
  createdAt       DateTime @default(now())

  venue           Venue @relation(fields: [venueId], references: [id])

  @@unique([provider, providerVenueId])
  @@index([venueId])
}

model Show {
  id               String   @id @default(cuid())
  artistId         String
  venueId          String
  startDatetimeUtc DateTime
  localDate        DateTime
  timezone         String?

  artist           Artist   @relation(fields: [artistId], references: [id])
  venue            Venue    @relation(fields: [venueId], references: [id])
  reviews          Review[]
  attendances      Attendance[]
  externalRefs     ShowExternalRef[]
  setlistCache     SetlistCache?

  createdAt        DateTime @default(now())

  @@unique([artistId, venueId, localDate])
  @@index([localDate])
}

model ShowExternalRef {
  id              String @id @default(cuid())
  showId          String
  provider        String
  providerEventId String
  rawPayload      Json?

  show            Show @relation(fields: [showId], references: [id])

  @@unique([provider, providerEventId])
  @@index([showId])
}

model Review {
  id               String @id @default(cuid())
  userId           String
  showId           String

  ratingOverall    Int
  reviewTextRaw    String

  tags             Json?
  highlights       Json?
  categoryScores   Json?
  sentiment        String?
  summary          String?

  moderationStatus ModerationStatus @default(PENDING)
  moderationFlags  Json?

  publishedAt      DateTime?
  createdAt        DateTime @default(now())

  user             User @relation(fields: [userId], references: [id])
  show             Show @relation(fields: [showId], references: [id])
  likes            ReviewLike[]
  comments         ReviewComment[]

  @@index([publishedAt])
  @@index([showId])
  @@index([userId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id])
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  showId     String
  attendedAt DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show       Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
  @@index([showId])
}

model SetlistCache {
  id        String   @id @default(cuid())
  showId    String   @unique
  status    String
  setlist   Json?
  fetchedAt DateTime?
  sourceUrl String?

  show      Show @relation(fields: [showId], references: [id])
}

model ProviderMatchReview {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  rawPayload        Json
  candidateShowIds  String[]
  resolvedArtistId  String?
  resolvedVenueId   String?
  reason            String
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?

  resolvedArtist    Artist?  @relation(fields: [resolvedArtistId], references: [id])
  resolvedVenue     Venue?   @relation(fields: [resolvedVenueId], references: [id])

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
}

model ReviewComment {
  id               String   @id @default(cuid())
  reviewId         String
  userId           String
  body             String
  moderationStatus ModerationStatus @default(PENDING)
  moderationFlags  Json?
  createdAt        DateTime @default(now())

  review           Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user             User   @relation(fields: [userId], references: [id])

  @@index([reviewId, createdAt])
  @@index([userId])
}

// Audit log: one row per ingestion execution (DICE / Bowery), created
// by the route-level withIngestRun wrapper. Answers "did ingestion run
// today, what happened, did it fail?" — works even for no-op runs.
// A row stuck at status="running" with a stale startedAt is the signal
// for a timed-out or killed run (e.g., the Vercel 300s function limit).
model IngestRun {
  id         String    @id @default(cuid())
  provider   String                          // "dice" | "bowery"
  status     String    @default("running")   // "running" | "success" | "error"
  trigger    String                          // "cron" | "manual"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  summary    Json?                           // orchestrator run summary
  error      String?                         // set when status="error"

  @@index([provider, startedAt])
}

// In-app notifications. Generic by design: `type` is a string (not an
// enum) and `entityId` + `metadata` carry type-specific payload, so new
// notification types ship without a schema change. v1 types: "follow",
// "review_like", "review_comment". Created best-effort by the
// createNotification helper AFTER the primary action commits — a failed
// notification never rolls back the like/comment/follow it describes.
model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  actorUserId     String?                       // who triggered it; nullable for future system notifications
  type            String                        // "follow" | "review_like" | "review_comment"
  entityId        String?                       // reviewId / commentId / follower id, by type
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  recipient       User      @relation("NotificationsReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?     @relation("NotificationsActed", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, createdAt])          // newest-first list
  @@index([recipientUserId, readAt])             // unread badge count
}
